# comfyui-alchemine-pack environment variables
# Copy this file to `.env` and fill in the values you need. All entries are
# optional — only set the ones for the nodes you use.

# --- OpenAI Inference (AlcheminePack/Inference) -------------------------------
# Defaults for the OpenAI Inference node. You can instead pass these as node
# inputs; the env vars are the fallback when the inputs are empty. `base_url` is
# the OpenAI-compatible endpoint (e.g. https://api.openai.com/v1, a vLLM/Ollama
# `/v1` server, etc.).
OPENAI_BASE_URL=
OPENAI_API_KEY=

# --- Grok (AlcheminePack/Grok) ------------------------------------------------
# Credentials for the Grok (image-to-video) nodes. You can instead pass
# these as node inputs; the env vars are the fallback when the inputs are empty.
GROK_ACCESS_TOKEN=
GROK_REFRESH_TOKEN=
GROK_CLIENT_ID=
