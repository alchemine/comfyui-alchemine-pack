# comfyui-alchemine-pack environment variables
# Copy this file to `.env` and fill in the values you need. All entries are
# optional — only set the ones for the nodes you use. (OpenAI Inference keys go
# in config.json, not here.)

# --- Grok (AlcheminePack/Grok) ------------------------------------------------
# Credentials for the Grok Generate (image-to-video) node. You can instead pass
# these as node inputs; the env vars are the fallback when the inputs are empty.
GROK_ACCESS_TOKEN=
GROK_REFRESH_TOKEN=
GROK_CLIENT_ID=

# --- Webshare proxy (AlcheminePack/Danbooru) ----------------------------------
# Optional rotating proxy for the Danbooru nodes (to dodge rate limits / IP
# bans). Leave blank to connect directly. Both username and password must be set
# for the proxy to be used. SERVER defaults to the Webshare rotating endpoint.
WEBSHARE_PROXY_USERNAME=
WEBSHARE_PROXY_PASSWORD=
# WEBSHARE_PROXY_SERVER=http://p.webshare.io:80
